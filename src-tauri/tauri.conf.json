{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropNet",
  "version": "0.1.0",
  "identifier": "com.dropnet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DropNet",
        "width": 1000,
        "height": 640,
        "minWidth": 780,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"] }
}
